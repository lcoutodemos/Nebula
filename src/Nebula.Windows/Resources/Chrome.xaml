<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Nebula chrome. Rules:
      * Glass is a navigation layer over the photo canvas (native Direct3D blur). XAML panels stay
        almost transparent so that blur is visible; no flat outlines, the native rim is the edge.
      * Monochrome. Blue (system accent) is reserved for the selected photo and keyboard focus.
      * Concentric radii: 18 for cards and capsules, inner shapes = 18 minus their inset.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CanvasGroundBrush" Color="#141416"/>
            <SolidColorBrush x:Key="PanelFallbackBrush" Color="#F0222225"/>
            <SolidColorBrush x:Key="PanelVeilBrush" Color="#06000000"/>
            <SolidColorBrush x:Key="PanelRimBrush" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="InsetFillBrush" Color="#0DFFFFFF"/>
            <SolidColorBrush x:Key="InsetStrokeBrush" Color="#0FFFFFFF"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="#0FFFFFFF"/>
            <SolidColorBrush x:Key="RowPressedBrush" Color="#0AFFFFFF"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#1CFFFFFF"/>
            <SolidColorBrush x:Key="RowSelectedHoverBrush" Color="#24FFFFFF"/>
        <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="RowHoverBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="RowPressedBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="RowSelectedBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="RowSelectedHoverBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="RowSelectedBrush"/>
            <SolidColorBrush x:Key="SegmentPillBrush" Color="#2BFFFFFF"/>
            <SolidColorBrush x:Key="SegmentHoverBrush" Color="#10FFFFFF"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="BarTrackBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="BarFillBrush" Color="#8CFFFFFF"/>
            <SolidColorBrush x:Key="FocusRimBrush" Color="#66FFFFFF"/>
            <SolidColorBrush x:Key="HoverTagBrush" Color="#EB1E1E21"/>
            <SolidColorBrush x:Key="HoverTagRimBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="MenuGlassBrush" Color="#8C1C1C1F"/>
            <SolidColorBrush x:Key="MenuRimBrush" Color="#24FFFFFF"/>
            <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="PrimaryCapsuleBrush" Color="#F2F4F4F2"/>
            <SolidColorBrush x:Key="PrimaryCapsuleHoverBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="PrimaryCapsulePressedBrush" Color="#D9F4F4F2"/>
            <SolidColorBrush x:Key="PrimaryCapsuleForegroundBrush" Color="#FF161618"/>
            <SolidColorBrush x:Key="QuietCapsuleBrush" Color="#14FFFFFF"/>
            <SolidColorBrush x:Key="QuietCapsuleHoverBrush" Color="#1FFFFFFF"/>
            <SolidColorBrush x:Key="QuietCapsulePressedBrush" Color="#0FFFFFFF"/>
            <SolidColorBrush x:Key="MonoInkBrush" Color="#EBF4F4F2"/>
            <SolidColorBrush x:Key="MonoSelectionBrush" Color="#1CFFFFFF"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CanvasGroundBrush" Color="#EFEFED"/>
            <SolidColorBrush x:Key="PanelFallbackBrush" Color="#F2F9F9F7"/>
            <SolidColorBrush x:Key="PanelVeilBrush" Color="#08FFFFFF"/>
            <SolidColorBrush x:Key="PanelRimBrush" Color="#14000000"/>
            <SolidColorBrush x:Key="InsetFillBrush" Color="#8CFFFFFF"/>
            <SolidColorBrush x:Key="InsetStrokeBrush" Color="#0D000000"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="#0A000000"/>
            <SolidColorBrush x:Key="RowPressedBrush" Color="#07000000"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="#12000000"/>
            <SolidColorBrush x:Key="RowSelectedHoverBrush" Color="#17000000"/>
        <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="RowHoverBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="RowPressedBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="RowSelectedBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="RowSelectedHoverBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="RowSelectedBrush"/>
            <SolidColorBrush x:Key="SegmentPillBrush" Color="#F2FFFFFF"/>
            <SolidColorBrush x:Key="SegmentHoverBrush" Color="#0A000000"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="#1A000000"/>
            <SolidColorBrush x:Key="BarTrackBrush" Color="#12000000"/>
            <SolidColorBrush x:Key="BarFillBrush" Color="#66000000"/>
            <SolidColorBrush x:Key="FocusRimBrush" Color="#4D000000"/>
            <SolidColorBrush x:Key="HoverTagBrush" Color="#F2FAFAF8"/>
            <SolidColorBrush x:Key="HoverTagRimBrush" Color="#14000000"/>
            <SolidColorBrush x:Key="MenuGlassBrush" Color="#A6F7F7F5"/>
            <SolidColorBrush x:Key="MenuRimBrush" Color="#1A000000"/>
            <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="#0F000000"/>
            <SolidColorBrush x:Key="PrimaryCapsuleBrush" Color="#F21C1C1E"/>
            <SolidColorBrush x:Key="PrimaryCapsuleHoverBrush" Color="#FF000000"/>
            <SolidColorBrush x:Key="PrimaryCapsulePressedBrush" Color="#D91C1C1E"/>
            <SolidColorBrush x:Key="PrimaryCapsuleForegroundBrush" Color="#FFF8F8F6"/>
            <SolidColorBrush x:Key="QuietCapsuleBrush" Color="#0F000000"/>
            <SolidColorBrush x:Key="QuietCapsuleHoverBrush" Color="#17000000"/>
            <SolidColorBrush x:Key="QuietCapsulePressedBrush" Color="#0A000000"/>
            <SolidColorBrush x:Key="MonoInkBrush" Color="#E8212121"/>
            <SolidColorBrush x:Key="MonoSelectionBrush" Color="#12000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CanvasGroundBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PanelFallbackBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PanelVeilBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PanelRimBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="InsetFillBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="InsetStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="RowPressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="RowSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="RowSelectedHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="RowHoverBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="RowPressedBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="RowSelectedBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="RowSelectedHoverBrush"/>
        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="RowSelectedBrush"/>
            <SolidColorBrush x:Key="SegmentPillBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="SegmentHoverBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="BarTrackBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="BarFillBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="FocusRimBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="HoverTagBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="HoverTagRimBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MenuGlassBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="MenuRimBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="ThumbPlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="PrimaryCapsuleBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="PrimaryCapsuleHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PrimaryCapsulePressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PrimaryCapsuleForegroundBrush" Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="QuietCapsuleBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="QuietCapsuleHoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="QuietCapsulePressedBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="MonoInkBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="MonoSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ListView rows: concentric pills, monochrome, no left accent bar. -->
    <CornerRadius x:Key="ListViewItemCornerRadius">10</CornerRadius>
    <x:Boolean x:Key="ListViewItemSelectionIndicatorVisualEnabled">False</x:Boolean>


    <!-- Toolbar menus: the same glass and type as the capsules they drop from. 14 outer radius,
         5 inset, 9 rows: concentric. Implicit item styles only set properties; the system
         template still draws checkmarks, accelerators and sub-menu chevrons. -->
    <Style x:Key="GlassMenuPresenterStyle" TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource MenuGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource MenuRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="MinWidth" Value="188"/>
    </Style>
    <Style TargetType="MenuFlyoutItem">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="10,6,14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style TargetType="ToggleMenuFlyoutItem">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="10,6,14,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style TargetType="MenuFlyoutSubItem">
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="10,6,10,7"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style TargetType="MenuFlyoutSeparator">
        <Setter Property="Padding" Value="10,4"/>
    </Style>
    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Background" Value="{ThemeResource PanelFallbackBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource PanelRimBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>
    <Style x:Key="EyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="60"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
    </Style>
    <!-- Note: the quiet line that says how to read a graphic. -->
    <Style x:Key="NoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="LineHeight" Value="15"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/>
    </Style>
    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- A capsule-shaped icon button: platform template, monochrome hover/pressed fills. -->
    <!-- Toolbar/icon capsule. Owned template: hover is a "Hover" layer that MainPage drives from the
         real cursor (no system PointerOver state that can stick in the caption strip); press dims. -->
    <Style x:Key="IconCapsuleStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="-2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Content.Opacity" Value="0.72"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Content.Opacity" Value="0.4"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource SegmentHoverBrush}">
                            <Border.OpacityTransition><ScalarTransition Duration="0:0:0.12"/></Border.OpacityTransition>
                        </Border>
                        <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          AutomationProperties.AccessibilityView="Raw"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietCapsuleStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{ThemeResource QuietCapsuleBrush}"/>
    </Style>
    <Style x:Key="PrimaryCapsuleStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="{ThemeResource PrimaryCapsuleBrush}"/>
        <Setter Property="Foreground" Value="{ThemeResource PrimaryCapsuleForegroundBrush}"/>
    </Style>
    <!-- Source-list row as a button: full-width, left-aligned, concentric pill. -->
    <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <!-- Row container we own end to end: ListViewItemPresenter draws a square backplate whatever
         CornerRadius says, so hover / press / selection live on a rounded Border here. -->
    <Style x:Key="MonoRowItemStyle" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters><Setter Target="Backplate.Background" Value="{ThemeResource RowHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Backplate.Background" Value="{ThemeResource RowPressedBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters><Setter Target="Backplate.Background" Value="{ThemeResource RowSelectedBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters><Setter Target="Backplate.Background" Value="{ThemeResource RowSelectedHoverBrush}"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters><Setter Target="Backplate.Background" Value="{ThemeResource RowSelectedBrush}"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled"/>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters><Setter Target="Root.Opacity" Value="0.45"/></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Backplate" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.BackgroundTransition><BrushTransition Duration="0:0:0.12"/></Border.BackgroundTransition>
                        </Border>
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SourceItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource MonoRowItemStyle}">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="ExploreItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource MonoRowItemStyle}">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="4,1"/>
    </Style>

    <!-- Segment of the arrangement capsule. The selected pill is a separate sliding element. -->
    <Style x:Key="SegmentStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="FocusVisualMargin" Value="-2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <!-- Hover is drawn by MainPage from live pointer position (the toolbar sits in the
                                     caption strip, where WinUI can miss PointerExited and leave this state on). -->
                                <VisualState x:Name="PointerOver"/>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters><Setter Target="Label.Opacity" Value="0.72"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Label.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}"/>
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters><Setter Target="Hover.Visibility" Value="Collapsed"/></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked"/>
                                <VisualState x:Name="Indeterminate"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Hover" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource SegmentHoverBrush}">
                            <Border.OpacityTransition><ScalarTransition Duration="0:0:0.12"/></Border.OpacityTransition>
                        </Border>
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SearchFieldStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,6,6,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
